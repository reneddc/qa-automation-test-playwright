{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "tests/**/*.ts",
    "pages/**/*.ts",
    "data/**/*.ts",
    "clients/**/*.ts",
    "config/**/*.ts",
    "entities/**/*.ts",
    "fixtures/**/*.ts",
    "playwright.config.ts"
  ]
}
